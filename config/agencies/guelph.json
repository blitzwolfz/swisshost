{
  "id": "guelph",
  "name": "Guelph Transit",
  "shortName": "Guelph",
  "region": "Ontario, Canada",
  "timezone": "America/Toronto",
  "modes": ["bus"],
  "center": [-80.2482, 43.5448],
  "defaultZoom": 12.5,
  "enabled": true,
  "attribution": "Data provided by City of Guelph Open Data (Guelph Transit)",
  "licenseUrl": "https://data.guelph.ca/",
  "archivePolicy": "permitted",
  "capabilities": {
    "staticSchedule": true,
    "vehiclePositions": true,
    "tripUpdates": true,
    "serviceAlerts": true,
    "historicalArchive": true
  },
  "feeds": [
    {
      "id": "guelph-static",
      "kind": "gtfs_static",
      "adapter": "gtfs-static",
      "url": "https://gismaps.guelph.ca/Pages/GTFS/google_transit.zip",
      "fallbackUrl": "https://drive.usercontent.google.com/download?id=1SsCgQ0agO_EONavJoOuBPMlbcu2VcUs4&export=download",
      "refreshSeconds": 86400,
      "authSecretRef": null,
      "enabled": true,
      "staleAfterSeconds": 172800
    },
    {
      "id": "guelph-positions",
      "kind": "vehicle_positions",
      "adapter": "gtfs-rt",
      "url": "https://glphprdtmgtfs.glphtrpcloud.com/tmgtfsrealtimewebservice/vehicle/vehiclepositions.pb",
      "refreshSeconds": 60,
      "authSecretRef": null,
      "enabled": true,
      "staleAfterSeconds": 120
    },
    {
      "id": "guelph-trip-updates",
      "kind": "trip_updates",
      "adapter": "gtfs-rt",
      "url": "https://glphprdtmgtfs.glphtrpcloud.com/tmgtfsrealtimewebservice/tripupdate/tripupdates.pb",
      "refreshSeconds": 60,
      "authSecretRef": null,
      "enabled": true,
      "staleAfterSeconds": 120
    },
    {
      "id": "guelph-alerts",
      "kind": "service_alerts",
      "adapter": "gtfs-rt",
      "url": "https://glphprdtmgtfs.glphtrpcloud.com/tmgtfsrealtimewebservice/alert/alerts.pb",
      "refreshSeconds": 300,
      "authSecretRef": null,
      "enabled": true,
      "staleAfterSeconds": 600
    }
  ]
}
