{
  "name": "swisshost",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @swisshost/web dev",
    "dev:worker": "wrangler dev",
    "build": "pnpm --filter @swisshost/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply swisshost-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply swisshost-db --remote",
    "deploy": "pnpm build && wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "hono": "^4.7.6",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250409.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.1.1",
    "wrangler": "^4.10.0"
  }
}
